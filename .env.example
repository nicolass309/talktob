# URL Base del Backend de TalktoB (por defecto http://localhost:8000)
VITE_API_URL=http://localhost:8000

# Clave pública de Clerk para React frontend
# Si no está configurada o es placeholder (ej. contiene ZXhhbXBsZS1jbGVyay), se usará el modo dev sin Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS1jbGVyay1rZXktbHNjaC10YWxrdG9iLmNsa2FwcC5kZXYk

# Token de autenticación para modo desarrollo sin Clerk
# Solo desarrollo, el backend debe tener AUTH_DEV_MODE=true
VITE_DEV_AUTH_TOKEN=dev:mi_usuario_local
